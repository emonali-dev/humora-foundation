# HUMORA FOUNDATION – configuration reference.
# This is a static site: the browser only needs the PUBLIC values below, which
# live in assets/js/config.js (safe to commit — protected by Row Level Security).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SITE_URL=https://humora-foundation.vercel.app

# Server-side only — set as Supabase Edge Function secrets, NEVER in frontend code or GitHub:
#   supabase secrets set HUMORA_ALLOWED_ORIGINS=https://your-domain.org,https://humora-foundation.vercel.app
# SUPABASE_SERVICE_ROLE_KEY is provided to Edge Functions automatically by Supabase.
HUMORA_ALLOWED_ORIGINS=https://humora-foundation.vercel.app
